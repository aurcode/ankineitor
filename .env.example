# Ankineitor Configuration File
# Copy this file to .env and update with your actual values

# === REQUIRED SETTINGS ===

# Groq API Key (Required for LLM functionality)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# === OPTIONAL SETTINGS ===

# Database Configuration
PIPELINE_DB_PATH=data/ankineitor_pipeline.db
LLM_CACHE_DB_PATH=data/ankineitor_llm_cache.db

# Audio Configuration
AUDIO_OUTPUT_DIR=./my_audio_files

# LLM Configuration
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_RETRIES=3
LLM_TIMEOUT=30

# Security Settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=[".csv", ".txt", ".pdf", ".docx", ".pptx"]

# Application Settings
LOG_LEVEL=INFO
DEV_MODE=false

# === EXAMPLE VALUES ===
# GROQ_API_KEY=gsk_1234567890abcdef1234567890abcdef
# LOG_LEVEL=DEBUG
# MAX_FILE_SIZE_MB=5
