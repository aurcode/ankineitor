# Ankineitor Configuration File
# Copy this file to .env and update with your actual values

# === REQUIRED SETTINGS ===

# Gemini / Vertex credential token (preferred)
# Supported aliases in app: LLM_API_TOKEN, GEMINI_API_KEY, GOOGLE_API_KEY,
# VERTEX_API_TOKEN, GCP_API_TOKEN, GOOGLE_CLOUD_ACCESS_TOKEN
LLM_API_TOKEN=your_gemini_or_vertex_token_here

# === OPTIONAL SETTINGS ===

# Database Configuration
PIPELINE_DB_PATH=data/ankineitor_pipeline.db
LLM_CACHE_DB_PATH=data/ankineitor_llm_cache.db

# Audio Configuration
AUDIO_OUTPUT_DIR=./my_audio_files
IMAGE_OUTPUT_DIR=./my_image_files
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_API_TOKEN=
MINIMAX_GROUP_ID=
MINIMAX_TTS_VOICE_ID=
MINIMAX_TTS_BASE_URL=https://api.minimaxi.com

# LLM Configuration
LLM_MODEL=gemini-3.1-pro-preview
LLM_IMAGE_MODEL=gemini-3-pro-image-preview
LLM_IMAGE_MAX_WORKERS=1
LLM_SOURCE_LANGUAGE="Chinese (Simplified)"
LLM_TARGET_LANGUAGE=english
# Optional second target for non-Chinese words (blank disables)
LLM_SECONDARY_TARGET_LANGUAGE=
LLM_MAX_RETRIES=3
LLM_TIMEOUT=30
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=us-central1
BQ_CREDENTIALS_PATH=/path/to/service-account.json

# Security Settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=[".csv", ".txt", ".pdf", ".docx", ".pptx"]

# Application Settings
LOG_LEVEL=INFO
DEV_MODE=false

# === EXAMPLE VALUES ===
# LLM_API_TOKEN=AQ.xxxxxx
# GCP_PROJECT_ID=data-worldsacross
# LOG_LEVEL=DEBUG
# MAX_FILE_SIZE_MB=5
